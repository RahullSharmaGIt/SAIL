generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Record {
  id         Int       @id @default(autoincrement())
  name       String?
  category   String?
  status     String?
  amount     Decimal?  @db.Decimal(12, 2)
  createdAt  DateTime  @map("created_at") @default(now())
  updatedAt  DateTime  @map("updated_at") @updatedAt

  @@map("records")
}
